# =============================================================================
# Weather Activity Ranker — env vars
# =============================================================================
# Copy to .env for local dev. Values here are safe defaults.
# See specs/00-overview.spec.md#environment-variable-registry for the canonical list.

# ------------------------------------------------------------------
# Server (packages/server)
# ------------------------------------------------------------------

# Node environment. `production` disables the GraphQL playground and enables the static SPA handler.
# NODE_ENV=development

# Fastify listen port.
# PORT=4000

# Pino log level: trace | debug | info | warn | error | fatal
# LOG_LEVEL=info

# Comma-separated allowed origins for CORS. Only used in dev (prod is same-origin).
# CORS_ORIGIN=http://localhost:5173

# Open-Meteo mode: `live` hits the real API; `stub` reads from __fixtures__ (used by CI + Playwright).
# OPEN_METEO_MODE=live

# HTTP timeout for outbound Open-Meteo requests (ms).
# OPEN_METEO_TIMEOUT_MS=3000

# LRU cache TTLs (ms).
# CACHE_TTL_WEATHER_MS=1800000     # 30 min
# CACHE_TTL_MARINE_MS=1800000      # 30 min
# CACHE_TTL_AQI_MS=1800000         # 30 min
# CACHE_TTL_GEOCODING_MS=86400000  # 24 h

# @fastify/rate-limit config.
# RATE_LIMIT_MAX=60
# RATE_LIMIT_WINDOW_MS=60000

# GraphQL introspection. Off in prod by default; only turn on if you need schema discovery from a client.
# EXPOSE_INTROSPECTION=false

# Optional: enables Claude Haiku week-summary. Without it, a deterministic template is used.
# ANTHROPIC_API_KEY=

# Kill-switch: max Claude summaries per UTC day before falling back to template. Guardrail #3.
# SUMMARIZER_DAILY_CAP=100

# ------------------------------------------------------------------
# Frontend (packages/web) — Vite exposes only VITE_* to the browser
# ------------------------------------------------------------------

# GraphQL endpoint. Same-origin `/graphql` by default (works in Fly.io single-container).
# In dev, override to the running backend, e.g. http://localhost:4000/graphql
# VITE_GRAPHQL_ENDPOINT=/graphql

# Default temperature unit: metric | imperial
# VITE_UNITS_DEFAULT=metric
