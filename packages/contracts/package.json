{
  "name": "@wa/contracts",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "GraphQL schema + generated types shared between server and web",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "files": ["schema.graphql", "src"],
  "scripts": {
    "codegen": "graphql-codegen --config codegen.ts",
    "codegen:watch": "graphql-codegen --config codegen.ts --watch",
    "typecheck": "tsc --noEmit",
    "test": "echo 'no tests in contracts' && exit 0"
  },
  "devDependencies": {
    "@graphql-codegen/cli": "^5.0.3",
    "@graphql-codegen/client-preset": "^4.5.1",
    "graphql": "^16.9.0",
    "typescript": "^5.6.3"
  }
}
