{
  "name": "@wa/web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Weather Activity Ranker — React frontend",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "NODE_OPTIONS=--experimental-vm-modules jest",
    "test:pact": "NODE_OPTIONS=--experimental-vm-modules jest --testPathPatterns=pact",
    "test:e2e": "playwright test",
    "test:e2e:install": "playwright install --with-deps chromium"
  },
  "dependencies": {
    "@apollo/client": "^3.13.0",
    "@graphql-typed-document-node/core": "^3.2.0",
    "@iconify-json/meteocons": "^1.2.4",
    "@iconify/react": "^6.0.2",
    "@number-flow/react": "^0.6.2",
    "@paper-design/shaders-react": "^0.0.78",
    "@phosphor-icons/react": "^2.1.10",
    "@wa/contracts": "workspace:*",
    "cmdk": "^1.1.1",
    "graphql": "^16.9.0",
    "motion": "^12.43.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-error-boundary": "^6.1.2",
    "react-router": "^8.3.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@jest/globals": "^30.0.0",
    "@pact-foundation/pact": "^17.0.1",
    "@playwright/test": "^1.62.0",
    "@swc/core": "^1.9.3",
    "@swc/jest": "^0.2.37",
    "@tailwindcss/vite": "^4.0.0",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/jest": "^29.5.14",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "jest": "^30.0.0",
    "jest-environment-jsdom": "^30.4.1",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.6.3",
    "vite": "^6.0.0"
  }
}
