{
  "consumer": {
    "name": "wa-web"
  },
  "interactions": [
    {
      "description": "a GraphQL query for activityRankings(\"Lisbon\")",
      "providerStates": [
        {
          "name": "city Lisbon exists and has weather"
        }
      ],
      "request": {
        "body": {
          "operationName": "ActivityRankings",
          "query": "\n  query ActivityRankings($cityQuery: String, $locationId: ID) {\n    activityRankings(cityQuery: $cityQuery, locationId: $locationId) {\n      __typename\n      ... on ActivityRankings {\n        city {\n          id\n          name\n          country\n        }\n        summary\n        rankings {\n          activity\n          overallScore\n        }\n      }\n    }\n  }\n",
          "variables": {
            "cityQuery": "Lisbon"
          }
        },
        "headers": {
          "Content-Type": "application/json"
        },
        "matchingRules": {
          "body": {
            "$.query": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "regex",
                  "regex": "\\s*query\\s*ActivityRankings\\(\\$cityQuery:\\s*String,\\s*\\$locationId:\\s*ID\\)\\s*\\{\\s*activityRankings\\(cityQuery:\\s*\\$cityQuery,\\s*locationId:\\s*\\$locationId\\)\\s*\\{\\s*__typename\\s*\\.\\.\\.\\s*on\\s*ActivityRankings\\s*\\{\\s*city\\s*\\{\\s*id\\s*name\\s*country\\s*\\}\\s*summary\\s*rankings\\s*\\{\\s*activity\\s*overallScore\\s*\\}\\s*\\}\\s*\\}\\s*\\}\\s*"
                }
              ]
            }
          }
        },
        "method": "POST",
        "path": "/graphql"
      },
      "response": {
        "body": {
          "data": {
            "activityRankings": {
              "__typename": "ActivityRankings",
              "city": {
                "country": "Portugal",
                "id": "2267057",
                "name": "Lisbon"
              },
              "rankings": [
                {
                  "activity": "OUTDOOR_SIGHTSEEING",
                  "overallScore": 78
                }
              ],
              "summary": "Lisbon this week: best for outdoor sightseeing."
            }
          }
        },
        "headers": {
          "Content-Type": "application/json"
        },
        "matchingRules": {
          "body": {
            "$.data.activityRankings.city.country": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "type"
                }
              ]
            },
            "$.data.activityRankings.city.id": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "type"
                }
              ]
            },
            "$.data.activityRankings.city.name": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "type"
                }
              ]
            },
            "$.data.activityRankings.rankings": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "type",
                  "min": 1
                }
              ]
            },
            "$.data.activityRankings.rankings[*].activity": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "type"
                }
              ]
            },
            "$.data.activityRankings.rankings[*].overallScore": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "integer"
                }
              ]
            },
            "$.data.activityRankings.summary": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "type"
                }
              ]
            }
          }
        },
        "status": 200
      }
    }
  ],
  "metadata": {
    "pact-js": {
      "version": "17.0.1"
    },
    "pactRust": {
      "ffi": "0.5.4",
      "models": "1.3.11"
    },
    "pactSpecification": {
      "version": "3.0.0"
    }
  },
  "provider": {
    "name": "wa-server"
  }
}